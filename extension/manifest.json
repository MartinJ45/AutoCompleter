{
    "manifest_version": 3,
    "name": "AI Google Docs Assistant",
    "version": "1.0",
    "description": "Auto-complete and enhance text in Google Docs using OpenAI.",
    "permissions": ["scripting", "activeTab", "storage"],
    "host_permissions": ["https://docs.google.com/*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://docs.google.com/document/*"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    }
  }
  