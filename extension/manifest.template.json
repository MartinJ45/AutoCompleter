{
    "manifest_version": 3,
    "name": "AI Google Docs Assistant",
    "version": "1.0",
    "description": "Auto-complete and enhance text in Google Docs using OpenAI.",
    "permissions": ["activeTab", "contextMenus", "storage", "identity"],
    "oauth2": {
      "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
      "scopes": ["https://www.googleapis.com/auth/documents", "https://www.googleapis.com/auth/drive.file"]
    },
    "host_permissions": ["https://docs.google.com/*", "https://www.googleapis.com/*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://docs.google.com/*"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    }
  }
  